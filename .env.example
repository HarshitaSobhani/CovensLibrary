# DEVELOPMENT ONLY. Copy to .env (git-ignored) on a development machine. Placeholders only - never commit real values.
# Never use this file on the Dell: production sets real environment variables with DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=change-me
# Development ONLY: true (so runserver serves static files). Production MUST be false.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=coven_library
# Runtime role (data access only). Owner credentials are NOT here: see .env.owner.example.
DB_USER=coven_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
